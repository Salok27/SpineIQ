<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Post-splash app theme: dark window so there is never a light flash
         before Compose draws the Neon Aurora surface. -->
    <style name="Theme.Back_pain_prototype" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deep_space</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: AndroidX SplashScreen on deep-space ink, handing off to
         the app theme once MainActivity is ready. -->
    <style name="Theme.Back_pain_prototype.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_space</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.Back_pain_prototype</item>
    </style>
</resources>
